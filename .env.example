# Server-only OpenAI API key.
# Do not use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=

# Optional server-only Serper.dev key for broader Google search discovery.
# Do not use NEXT_PUBLIC_ for secrets.
SERPER_API_KEY=your_serper_key_here

# Optional search depth: dev, standard, or deep.
SEARCH_DEPTH=dev

# Optional model override for the recommendation engine.
# The default in code is gpt-5.4-mini.
OPENAI_MODEL=

# Server-only production pipeline selector. Missing, empty, or exact "legacy"
# preserves the existing route. Exact "two_layer" enables the new signed
# background-job branch. Any other non-empty value fails closed.
REVIEW_RADAR_PIPELINE_MODE=legacy

# Server-only key material for encrypted background job tokens. Required when
# REVIEW_RADAR_PIPELINE_MODE=two_layer or REVIEW_RADAR_DIRECT_TERRA=on and must
# be at least 32 bytes.
# Generate an independent random value; never use NEXT_PUBLIC_ or reuse an API key.
REVIEW_RADAR_JOB_TOKEN_SECRET=

# Optional: pin the two discovery-planning calls to the documented GPT-5.4 mini
# snapshot with temperature 0. Custom OPENAI_HELPER_MODEL values are unchanged.
REVIEW_RADAR_PINNED_PLANNING=off

# Optional (Phase R4): constraint-preserving query allocation. Standalone
# Important Details become explicit preferences that shape search queries and
# are verified non-gatingly; subtype categories stop being diluted by parent
# synonyms in protected Shopping slots; duplicate budget wording is normalized.
REVIEW_RADAR_CONSTRAINT_ALLOCATION=off

# Optional (Corrective C3): recover a safe merchant product URL already present
# in a Serper result when the result's primary URL is rejected. The default-off
# path records shadow-only debug-ledger evidence and does not change responses.
REVIEW_RADAR_NORMALIZATION_RECOVERY=off

# Optional (Corrective C5): after all normal discovery and merchant-URL
# recovery, run at most four organic product-page lookups for deduplicated,
# model-specific structured provider identities that still have no safe page.
# Results must pass the existing organic normalizer, requested-type,
# eligibility, product-page identity, and cheap-prefilter gates.
REVIEW_RADAR_ORGANIC_IDENTITY_RESOLUTION=off

# Default-off V2 experiment. Both flags are required: the server flag enables
# the standalone Terra endpoint, and the non-secret public flag sends the UI to
# that endpoint. The legacy pipeline remains unchanged when either flag is off.
REVIEW_RADAR_DIRECT_TERRA=off
NEXT_PUBLIC_REVIEW_RADAR_DIRECT_TERRA=false
