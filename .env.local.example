# Required server-only Serper.dev key for live Shopping and product-page discovery.
# ReviewRadar cannot return product cards without current Serper discovery.
SERPER_API_KEY=

# Optional server-only OpenAI API key for the fresh request-time market scout.
# Without it, ReviewRadar falls back to neutral current-request Serper discovery.
OPENAI_API_KEY=

# Optional server-only request-parsing behavior. When on, otherwise ambiguous
# Important Details become non-gating preferences for the current request.
# This flag does not retain or reuse product research.
REVIEW_RADAR_CONSTRAINT_ALLOCATION=off
